# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=False

# Compute Hardware ('cuda', 'cpu', or leave blank for auto-detection)
# DEVICE=cpu

# Checkpoint Path (optional; auto-searches backend/models/ and root workspace)
# MODEL_CHECKPOINT_PATH=./models/efficientnet_b0_best.pth

# Monte Carlo Dropout Uncertainty Settings
MC_SAMPLES_DEFAULT=20
# Optional experimental entropy threshold in bits [0.0 - 1.0]. Leave blank if unconfigured.
# UNCERTAINTY_THRESHOLD=0.50

# CORS Configuration
# CORS_ORIGINS=["http://localhost:3000","http://localhost:8501","*"]
